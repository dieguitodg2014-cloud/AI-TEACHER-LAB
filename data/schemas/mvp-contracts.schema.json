{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-teacher-lab.local/schemas/mvp-contracts.schema.json",
  "title": "AI Teacher Lab MVP Contracts",
  "description": "Minimum executable contracts for the MVP vertical slice. Architecture decides; these contracts define what components exchange.",
  "$defs": {
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "level", "audience", "duration_minutes", "objective", "constraints"],
      "properties": {
        "context_id": {"type": "string", "minLength": 1},
        "level": {"$ref": "#/$defs/Level"},
        "audience": {"type": "string", "minLength": 1},
        "group_size": {"type": "integer", "minimum": 1},
        "duration_minutes": {"type": "integer", "minimum": 1},
        "objective": {"type": "string", "minLength": 1},
        "topic": {"type": "string"},
        "prior_knowledge": {"type": "array", "items": {"type": "string"}},
        "technology": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "teacher_preferences": {"type": "object", "additionalProperties": true}
      }
    },
    "Level": {
      "type": "string",
      "enum": ["A0", "A1", "A2", "B1", "B2"]
    },
    "LevelDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "level", "linguistic_complexity", "cognitive_demand", "interaction_expectation", "scaffolding", "assessment_expectation"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "level": {"$ref": "#/$defs/Level"},
        "linguistic_complexity": {"type": "string", "minLength": 1},
        "cognitive_demand": {"type": "string", "minLength": 1},
        "interaction_expectation": {"type": "string", "minLength": 1},
        "scaffolding": {"type": "string", "minLength": 1},
        "autonomy_expectation": {"type": "string"},
        "grammar_precision": {"type": "string"},
        "fluency_expectation": {"type": "string"},
        "register": {"type": "string"},
        "assessment_expectation": {"type": "string", "minLength": 1}
      }
    },
    "LearningPlanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "objective", "sequence", "total_minutes", "evidence_of_learning"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["activity_id", "purpose", "interaction", "minutes"],
            "properties": {
              "activity_id": {"type": "string"},
              "purpose": {"type": "string", "minLength": 1},
              "interaction": {"type": "string", "minLength": 1},
              "minutes": {"type": "integer", "minimum": 1},
              "student_production": {"type": "string"},
              "assessment_link": {"type": "string"}
            }
          }
        },
        "total_minutes": {"type": "integer", "minimum": 1},
        "evidence_of_learning": {"type": "string", "minLength": 1},
        "resource_need": {"type": "string"}
      }
    },
    "AssessmentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_id", "type", "target", "evidence", "success_criteria"],
      "properties": {
        "assessment_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["FORMATIVE", "PERFORMANCE", "WRITTEN", "ORAL", "MIXED"]},
        "target": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "ResourceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "action", "purpose"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "enum": ["CREATE", "REUSE", "ADAPT", "OMIT", "NO_RESOURCE_REQUIRED"]},
        "resource_type": {"type": "string"},
        "purpose": {"type": "string", "minLength": 1},
        "reason": {"type": "string"},
        "required": {"type": "boolean"}
      }
    },
    "ToolDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "task_type", "selected_tool", "fallback_policy", "human_handoff_allowed"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "task_type": {"type": "string", "minLength": 1},
        "selected_tool": {"type": "string", "minLength": 1},
        "fallback_policy": {"type": "array", "items": {"type": "string"}},
        "human_handoff_allowed": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "TaskPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_type", "objective", "level", "required_output", "constraints", "quality_criteria"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "course_id": {"type": "string"},
        "lesson_id": {"type": "string"},
        "task_type": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "level": {"$ref": "#/$defs/Level"},
        "audience": {"type": "string"},
        "input_materials": {"type": "array", "items": {"type": "string"}},
        "required_output": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "preferred_tool": {"type": "string"},
        "fallback_tool": {"type": "string"},
        "quality_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED", "HUMAN_HANDOFF"]}
      }
    },
    "QCResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qc_id", "status", "score", "critical_failure", "checks"],
      "properties": {
        "qc_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["READY", "ACCEPTABLE", "REVISION_REQUIRED", "REJECT_AND_REDESIGN"]},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "critical_failure": {"type": "boolean"},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level_alignment", "objective_alignment", "communicative_value", "time_realism", "linguistic_accuracy", "assessment_alignment"],
          "properties": {
            "level_alignment": {"type": "boolean"},
            "objective_alignment": {"type": "boolean"},
            "communicative_value": {"type": "boolean"},
            "time_realism": {"type": "boolean"},
            "linguistic_accuracy": {"type": "boolean"},
            "assessment_alignment": {"type": "boolean"}
          }
        },
        "revision_required": {"type": "boolean"},
        "feedback": {"type": "array", "items": {"type": "string"}},
        "blocking_errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
